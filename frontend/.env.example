# Forja — variables del frontend (Vite). Copia este archivo a .env.local para desarrollo;
# en Vercel se cargan en Project Settings → Environment Variables.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La clave "anon" / "publishable". Es pública por diseño.
# NUNCA pongas aquí la clave "service_role" / "secret".
VITE_SUPABASE_ANON_KEY=

# Solo para demos sin backend: enseña las pantallas de cuenta sin crear nada en un servidor.
# VITE_FORJA_AUTH_PREVIEW=1
